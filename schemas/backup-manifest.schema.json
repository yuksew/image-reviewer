{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:image-reviewer:backup-manifest",
  "title": "日次バックアップの manifest.json",
  "description": "P8-4 の `backup` が書き、`restore`（CLI）が読む。人が読む台帳ではない（設計 §6.2）。**abi は 0.1**（足すだけなので上げない。P6 の規則）",
  "type": "object",
  "required": ["schema", "abi", "app_version", "created_at", "data_dir", "includes", "counts", "db_sha256", "db_bytes"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "urn:image-reviewer:backup-manifest"
    },
    "abi": {
      "const": "0.1"
    },
    "app_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "description": "作った時刻（UTC。`YYYY-MM-DDTHH:MM:SSZ`）",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "data_dir": {
      "type": "string",
      "minLength": 1
    },
    "includes": {
      "type": "object",
      "description": "何を含めたか。`db` は必須（これが無いと復元できない）",
      "required": ["db", "sidecar", "export", "library"],
      "additionalProperties": false,
      "properties": {
        "db": { "type": "boolean" },
        "sidecar": { "type": "boolean" },
        "export": { "type": "boolean" },
        "library": { "type": "boolean", "description": "画像の実体。既定は false（大きすぎる。専門 §5）" }
      }
    },
    "counts": {
      "type": "object",
      "description": "復元の前に人が見る数（`restore` が版と一緒に出す）",
      "required": ["assets", "decisions", "groups", "annotations", "tags"],
      "additionalProperties": false,
      "properties": {
        "assets": { "type": "integer", "minimum": 0 },
        "decisions": { "type": "integer", "minimum": 0 },
        "groups": { "type": "integer", "minimum": 0 },
        "annotations": { "type": "integer", "minimum": 0 },
        "tags": { "type": "integer", "minimum": 0 }
      }
    },
    "db_sha256": {
      "type": "string",
      "description": "控えた DB の中身のハッシュ（`sha256:` の接頭辞つき）",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "db_bytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
