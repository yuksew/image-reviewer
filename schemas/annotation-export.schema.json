{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:image-reviewer:schema:annotation-export",
  "title": "image-reviewer 注記の書き出し",
  "description": "1 枚の画像に付いた注記の座標と文（P6 の設計 §6.2）。review.json とは別の契約にする（注記は 1 枚に多数入り、寿命も読む相手も違うため。全件書き出しを図形の数だけ膨らませない）。`GET /api/assets/{id}/annotations/export?format=json` が返し、`POST .../export {format:'crops'}` の応答には `crops` が入る。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "asset_id", "image", "annotations"],
  "properties": {
    "schema": { "const": "urn:image-reviewer:schema:annotation-export" },
    "abi": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "契約の版。review-export と同じく**文字列**（点検 D2）。"
    },
    "generated_at": { "$ref": "#/$defs/Timestamp" },
    "asset_id": { "$ref": "#/$defs/AssetId" },
    "image": {
      "type": "object",
      "description": "切り出しの計算に使った実体の画素数。",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "annotations": {
      "type": "array",
      "description": "古い順（`created_at, id`）。**座標が全部 null のものは「画像 1 枚へのメモ」**（点検 A1。領域が無いので切り出せない）。",
      "items": { "$ref": "#/$defs/Annotation" }
    },
    "crops": {
      "type": ["array", "null"],
      "description": "切り出しの一覧。座標 JSON の書き出し（`GET`）では **null**、切り出しの書き出し（`POST`）の応答では配列。",
      "items": { "$ref": "#/$defs/Crop" }
    }
  },
  "$defs": {
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "AssetId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "AnnotationId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "Annotation": {
      "type": "object",
      "description": "画像の上の印。**review-export.schema.json の `Annotation` と同じ形**（2 か所で別々に育てない。写しであることはテストで突き合わせる）。",
      "additionalProperties": false,
      "required": ["id", "asset_id"],
      "properties": {
        "id": { "$ref": "#/$defs/AnnotationId" },
        "asset_id": { "$ref": "#/$defs/AssetId" },
        "shape": {
          "type": ["string", "null"],
          "description": "rect=矩形、ellipse=楕円。**座標が全部 null のときは null**（画像 1 枚へのメモ）。",
          "enum": ["rect", "ellipse", null]
        },
        "x": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "左上の x（0〜1）。" },
        "y": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "左上の y（0〜1）。" },
        "w": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1, "description": "幅（0〜1。0 より大きい）。" },
        "h": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1, "description": "高さ（0〜1。0 より大きい）。" },
        "body": { "type": ["string", "null"], "description": "メモ。無ければ null（空文字にしない）。" },
        "actor": {
          "type": ["string", "null"],
          "description": "付けた人。human / agent。",
          "enum": ["human", "agent", null]
        },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "group_id": { "type": ["string", "null"], "description": "どのまとまりのレビューで付けたか。無ければ null。" }
      }
    },
    "Crop": {
      "type": "object",
      "description": "切り出した PNG 1 つ。**画素は元画像の座標**（`floor` / `ceil` の結果）。",
      "additionalProperties": false,
      "required": ["annotation_id", "path", "width", "height", "bytes"],
      "properties": {
        "annotation_id": { "$ref": "#/$defs/AnnotationId" },
        "path": {
          "type": "string",
          "description": "データ置き場からの相対パス。**絶対パスは出さない**（`include_paths` と同じ方針）。"
        },
        "left": { "type": ["integer", "null"], "description": "元画像での左上 x（画素）。" },
        "top": { "type": ["integer", "null"], "description": "元画像での左上 y（画素）。" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
